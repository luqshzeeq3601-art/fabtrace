@using FabTrace.Contracts

@if (FloorSummary is null)
{
    <div style="padding: 2rem; text-align: center; color: var(--text-muted);">
        Connecting to FabTrace API and loading live plant data...
    </div>
}
else
{
    <div class="machine-grid">
        @foreach (var machine in FloorSummary.Machines)
        {
            <div class="machine-card @(LastUpdatedMachine == machine.MachineCode ? "flash-updated" : "")">
                <div class="machine-card-header">
                    <div class="machine-identity">
                        <span class="machine-code">@machine.MachineCode</span>
                        <span class="machine-name">@machine.MachineName (@machine.Line)</span>
                    </div>
                    <span class="status-badge @GetStateBadgeClass(machine.CurrentState)">
                        @machine.CurrentState
                    </span>
                </div>

                <!-- Details -->
                <div class="machine-details">
                    <div class="detail-item">
                        <span>Lot</span>
                        <span>@(machine.CurrentLotNumber ?? "–")</span>
                    </div>
                    <div class="detail-item">
                        <span>Recipe</span>
                        <span>@(machine.CurrentRecipeCode ?? "–")</span>
                    </div>
                    <div class="detail-item">
                        <span>Operator</span>
                        <span>@(machine.CurrentOperatorBadge ?? "–")</span>
                    </div>
                    <div class="detail-item">
                        <span>State Since</span>
                        <span>@machine.StateStartedAt.ToString("HH:mm:ss")</span>
                    </div>
                </div>

                <!-- Active Alarms -->
                @if (machine.ActiveAlarms.Count > 0)
                {
                    <div class="machine-alarms-box">
                        <div style="font-weight: 700; margin-bottom: 0.25rem; color: #f87171;">
                            Active Alarms (@machine.ActiveAlarms.Count)
                        </div>
                        @foreach (var alarm in machine.ActiveAlarms)
                        {
                            <div class="alarm-item-mini">
                                <span class="@(alarm.Severity == AlarmSeverity.Critical ? "alarm-crit-tag" : "alarm-warn-tag")">
                                    @alarm.Severity: @alarm.AlarmCode
                                </span>
                                <span style="color: var(--text-secondary); margin-left: 0.5rem; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                    @alarm.Message
                                </span>
                            </div>
                        }
                    </div>
                }

                <!-- Throughput -->
                <div class="machine-throughput">
                    <div class="throughput-stats">
                        <span style="color: var(--text-muted);">Shift Inspected: <strong>@machine.ShiftUnitsInspected</strong></span>
                        <span style="color: var(--text-muted);">Yield: <strong>@machine.YieldPercent.ToString("F1")%</strong></span>
                    </div>
                    <div class="yield-bar-bg">
                        <div class="yield-bar-fill" style="width: @(Math.Clamp(machine.YieldPercent, 0, 100))%; background: @(machine.YieldPercent >= 95 ? "var(--status-running)" : "var(--status-down)")"></div>
                    </div>
                    <div style="font-size: 0.7rem; color: var(--text-muted); display: flex; justify-content: space-between;">
                        <span>@machine.ShiftUnitsPassed Pass</span>
                        <span>@machine.ShiftUnitsFailed Fail</span>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Active Alarms Table -->
    <div class="alarms-feed-card">
        <h3 class="section-title">
            Floor Active Alarms (@AllActiveAlarms.Count)
        </h3>
        @if (AllActiveAlarms.Count == 0)
        {
            <div style="color: var(--text-muted); font-size: 0.85rem; padding: 0.5rem 0;">
                No active alarms across the floor.
            </div>
        }
        else
        {
            <table class="scada-table">
                <thead>
                    <tr>
                        <th>Severity</th>
                        <th>Machine</th>
                        <th>Code</th>
                        <th>Message</th>
                        <th>Raised (UTC+8)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in AllActiveAlarms)
                    {
                        <tr>
                            <td>
                                <span class="@(a.Severity == AlarmSeverity.Critical ? "alarm-crit-tag" : "alarm-warn-tag")">
                                    @a.Severity
                                </span>
                            </td>
                            <td><strong>@a.MachineCode</strong></td>
                            <td>@a.AlarmCode</td>
                            <td>@a.Message</td>
                            <td>@a.RaisedAt.AddHours(8).ToString("yyyy-MM-dd HH:mm:ss")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    [Parameter] public LiveFloorSummaryDto? FloorSummary { get; set; }
    [Parameter] public string? LastUpdatedMachine { get; set; }
    [Parameter] public IReadOnlyList<LiveAlarmDto> AllActiveAlarms { get; set; } = [];

    private static string GetStateBadgeClass(MachineState state) => state switch
    {
        MachineState.Running => "badge-running",
        MachineState.Idle => "badge-idle",
        MachineState.Down => "badge-down",
        MachineState.Setup => "badge-setup",
        MachineState.Maintenance => "badge-maint",
        _ => ""
    };
}
