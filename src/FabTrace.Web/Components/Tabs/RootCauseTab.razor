@using FabTrace.Contracts
@using FabTrace.Web.Services
@inject FabTraceApiClient ApiClient
@inject UserSession Session

<div class="panel-card">
    <h3 class="section-title">Automated Root-Cause Diagnostic View</h3>
    <p style="color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 1rem;">
        Surfaces statistical anomalies and failure signatures across machines, recipe versions, and shifts.
    </p>

    <button class="scada-btn" style="margin-bottom: 1.5rem;" @onclick="RunRootCauseDiagnostic">Run Root-Cause Diagnosis</button>

    @if (RootCauseData is not null)
    {
        <!-- Planted Problem Findings -->
        <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem;">
            @foreach (var finding in RootCauseData.IdentifiedRootCauses)
            {
                <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); border-left: 4px solid var(--status-down); padding: 1rem; border-radius: 6px;">
                    <div style="font-weight: 700; color: #f87171; margin-bottom: 0.25rem;">Root Cause Detected</div>
                    <div style="font-size: 0.9rem; color: #ffffff;">@finding</div>
                </div>
            }
        </div>

        <!-- Defect Pareto -->
        <h4 style="margin: 1.5rem 0 0.5rem 0; font-size: 0.95rem; color: #ffffff;">Defect Pareto Analysis</h4>
        <table class="scada-table" style="margin-bottom: 1.5rem;">
            <thead>
                <tr>
                    <th>Defect Code</th>
                    <th>Count</th>
                    <th>Percentage of Total Failures</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var def in RootCauseData.DefectPareto)
                {
                    <tr>
                        <td><strong>@def.DefectCode</strong></td>
                        <td>@def.DefectCount</td>
                        <td>
                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                <div style="width: 120px; height: 8px; background: #334155; border-radius: 4px; overflow: hidden;">
                                    <div style="width: @def.Percentage%; height: 100%; background: var(--badge-crit);"></div>
                                </div>
                                <span>@def.Percentage.ToString("F1")%</span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Parametric Drift -->
        @if (RootCauseData.ParametricDrifts.Count > 0)
        {
            <h4 style="margin: 1.5rem 0 0.5rem 0; font-size: 0.95rem; color: #ffffff;">Parametric Drift (ContactResistance on Testers)</h4>
            <table class="scada-table">
                <thead>
                    <tr>
                        <th>Machine</th>
                        <th>Date</th>
                        <th>Readings</th>
                        <th>Avg Value (&Omega;)</th>
                        <th>Max Value (&Omega;)</th>
                        <th>Upper Limit</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var drift in RootCauseData.ParametricDrifts)
                    {
                        <tr>
                            <td><strong>@drift.MachineCode</strong></td>
                            <td>@drift.InspectionDate.ToString("yyyy-MM-dd")</td>
                            <td>@drift.ReadingCount</td>
                            <td style="color: @(drift.AvgValue > 0.08 ? "var(--status-down)" : "inherit");">
                                <strong>@drift.AvgValue.ToString("F4")</strong>
                            </td>
                            <td>@drift.MaxValue.ToString("F4")</td>
                            <td>@(drift.UpperLimit?.ToString("F4") ?? "–")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</div>

@code {
    [Parameter] public DateTime ReportFromDate { get; set; } = DateTime.UtcNow.Date.AddDays(-30);
    [Parameter] public DateTime ReportToDate { get; set; } = DateTime.UtcNow.Date.AddDays(1);

    private RootCauseAnalysisDto? RootCauseData;

    private async Task RunRootCauseDiagnostic()
    {
        RootCauseData = await ApiClient.GetRootCauseAnalysisAsync(ReportFromDate, ReportToDate, Session.Token);
    }
}
