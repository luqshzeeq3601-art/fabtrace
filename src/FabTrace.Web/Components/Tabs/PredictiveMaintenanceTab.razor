@using FabTrace.Contracts
@using FabTrace.Web.Services
@inject FabTraceApiClient ApiClient
@inject UserSession Session

<div class="panel-card">
    <div class="panel-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <div>
            <h2 class="panel-title" style="margin: 0;">🔮 Predictive Maintenance &amp; Time-Series Anomaly Detection</h2>
            <p style="margin: 0.25rem 0 0 0; font-size: 0.85rem; color: var(--text-muted);">
                Time-series change-point detection &amp; spike anomaly tracking powered by <strong>ML.NET</strong> (<code>Microsoft.ML.TimeSeries</code>). Flags sensor drift and mechanical degradation prior to hardware failures.
            </p>
        </div>
        <button class="scada-btn" @onclick="RefreshFleetHealth">Refresh Fleet Diagnostics</button>
    </div>

    <!-- Fleet Health Overview Cards -->
    @if (FleetHealthList is not null)
    {
        <h4 style="margin: 0 0 0.75rem 0; font-size: 0.95rem; color: #ffffff;">Fleet Machine Health Status</h4>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
            @foreach (var m in FleetHealthList)
            {
                var borderCol = m.HealthStatus == "Critical" ? "var(--status-down)" :
                                m.HealthStatus == "Degrading" ? "#f59e0b" :
                                m.HealthStatus == "Warning" ? "#eab308" : "var(--status-running)";
                <div style="background: var(--surface-card); border: 1px solid var(--border-color); border-left: 4px solid @borderCol; border-radius: 6px; padding: 1rem; cursor: pointer;"
                     @onclick="() => SelectMachineForAnalysis(m.MachineCode, m.MonitoredParameters.FirstOrDefault() ?? SelectedParameter)">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <span style="font-weight: 700; font-size: 1rem; color: #ffffff;">@m.MachineCode</span>
                        <span class="role-badge" style="background: @borderCol; color: #000; font-weight: 700; text-transform: uppercase;">@m.HealthStatus</span>
                    </div>
                    <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.5rem;">@m.MachineName &bull; @m.Line</div>
                    <div style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.5rem;">
                        Monitored: @(string.Join(", ", m.MonitoredParameters.Count > 0 ? m.MonitoredParameters : ["None"]))
                    </div>
                    <div style="font-size: 0.75rem; color: #cbd5e1; background: rgba(0,0,0,0.2); padding: 0.5rem; border-radius: 4px;">
                        @m.SummaryMessage
                    </div>
                </div>
            }
        </div>
    }

    <!-- Deep Dive Machine & Parameter ML Inspector -->
    <div style="background: var(--surface-card); border: 1px solid var(--border-color); border-radius: 6px; padding: 1.25rem; margin-bottom: 2rem;">
        <h4 style="margin: 0 0 1rem 0; font-size: 0.95rem; color: #ffffff;">ML.NET Time-Series Parameter Inspector</h4>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-end; margin-bottom: 1.5rem;">
            <div>
                <label style="display: block; font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.25rem;">Machine</label>
                <select class="scada-input" @bind="SelectedMachine">
                    <option value="FT-02">FT-02 (Final Tester - Planted Drift)</option>
                    <option value="FT-01">FT-01 (Final Tester Line 1)</option>
                    <option value="WB-01">WB-01 (Wire Bonder Line 1)</option>
                    <option value="WB-02">WB-02 (Wire Bonder Line 2)</option>
                    <option value="VI-01">VI-01 (Vision Inspector Line 1)</option>
                    <option value="VI-02">VI-02 (Vision Inspector Line 2)</option>
                </select>
            </div>

            <div>
                <label style="display: block; font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.25rem;">Parameter</label>
                <select class="scada-input" @bind="SelectedParameter">
                    <option value="ContactResistance">ContactResistance (m&Omega;)</option>
                    <option value="LeakageCurrent">LeakageCurrent (&mu;A)</option>
                    <option value="OutputVoltage">OutputVoltage (V)</option>
                    <option value="PullStrength">PullStrength (gf)</option>
                    <option value="BallShear">BallShear (gf)</option>
                    <option value="Coplanarity">Coplanarity (&mu;m)</option>
                </select>
            </div>

            <button class="scada-btn" @onclick="RunParameterAnalysis" disabled="@IsAnalyzingParameter">
                @(IsAnalyzingParameter ? "Analyzing with ML.NET..." : "Execute ML Analysis")
            </button>
        </div>

        @if (MaintenanceReport is not null)
        {
            <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: 6px; padding: 1.25rem; margin-bottom: 1.5rem;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
                    <div>
                        <h3 style="margin: 0; font-size: 1.1rem; color: #ffffff;">
                            @MaintenanceReport.MachineCode &ndash; @MaintenanceReport.ParameterName Analysis
                        </h3>
                        <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem;">
                            Samples: @MaintenanceReport.TotalSamples &bull; Baseline Mean: @MaintenanceReport.BaselineMean &bull; Current Mean: @MaintenanceReport.CurrentMean &bull; Drift: @MaintenanceReport.DriftPercentage.ToString("+0.0;-0.0")%
                        </div>
                    </div>
                    <div class="role-badge" style="background: @(MaintenanceReport.HealthStatus == "Critical" ? "var(--status-down)" : MaintenanceReport.HealthStatus == "Degrading" ? "#f59e0b" : "var(--status-running)"); color: #000; font-weight: 700; padding: 0.4rem 0.8rem;">
                        @MaintenanceReport.HealthStatus
                    </div>
                </div>

                <div style="background: rgba(239, 68, 68, 0.1); border-left: 4px solid @(MaintenanceReport.ChangePointDetected ? "var(--status-down)" : "var(--status-running)"); padding: 0.75rem 1rem; border-radius: 4px; margin-bottom: 1rem;">
                    <div style="font-weight: 700; font-size: 0.85rem; color: @(MaintenanceReport.ChangePointDetected ? "#f87171" : "#4ade80");">
                        @(MaintenanceReport.ChangePointDetected ? "🚨 Structural Change Point Detected by ML.NET" : "✅ Normal Process Control")
                    </div>
                    <div style="font-size: 0.85rem; color: #ffffff; margin-top: 0.25rem;">
                        @MaintenanceReport.Recommendation
                    </div>
                </div>

                <!-- Data Points Table with ML Anomaly Markers -->
                <h4 style="margin: 1rem 0 0.5rem 0; font-size: 0.9rem; color: #ffffff;">Recent Time-Series Readings &amp; Martingale Scoring</h4>
                <div style="max-height: 280px; overflow-y: auto;">
                    <table class="scada-table">
                        <thead>
                            <tr>
                                <th>Timestamp (UTC)</th>
                                <th>Value</th>
                                <th>Change Point</th>
                                <th>Spike Anomaly</th>
                                <th>P-Value</th>
                                <th>Martingale Score</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pt in MaintenanceReport.DataPoints.TakeLast(50).Reverse())
                            {
                                <tr style="@(pt.IsChangePoint ? "background: rgba(239, 68, 68, 0.2);" : pt.IsAnomaly ? "background: rgba(245, 158, 11, 0.15);" : "")">
                                    <td>@pt.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td><strong>@pt.Value.ToString("F3")</strong></td>
                                    <td>
                                        @if (pt.IsChangePoint)
                                        {
                                            <span style="color: #ef4444; font-weight: 700;">CHANGE POINT</span>
                                        }
                                        else
                                        {
                                            <span style="color: var(--text-muted);">&ndash;</span>
                                        }
                                    </td>
                                    <td>
                                        @if (pt.IsAnomaly)
                                        {
                                            <span style="color: #f59e0b; font-weight: 700;">SPIKE</span>
                                        }
                                        else
                                        {
                                            <span style="color: var(--text-muted);">&ndash;</span>
                                        }
                                    </td>
                                    <td>@pt.PValue.ToString("F4")</td>
                                    <td>@pt.MartingaleScore.ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public DateTime ReportFromDate { get; set; } = DateTime.UtcNow.Date.AddDays(-30);
    [Parameter] public DateTime ReportToDate { get; set; } = DateTime.UtcNow.Date.AddDays(1);

    private IReadOnlyList<MachineHealthSummaryDto>? FleetHealthList;
    private string SelectedMachine = "FT-02";
    private string SelectedParameter = "ContactResistance";
    private bool IsAnalyzingParameter = false;
    private PredictiveMaintenanceReportDto? MaintenanceReport;

    protected override async Task OnInitializedAsync()
    {
        await RefreshFleetHealth();
    }

    private async Task RefreshFleetHealth()
    {
        FleetHealthList = await ApiClient.GetFleetHealthSummaryAsync(ReportFromDate, ReportToDate, token: Session.Token);
    }

    private void SelectMachineForAnalysis(string machineCode, string parameterName)
    {
        SelectedMachine = machineCode;
        SelectedParameter = parameterName;
        _ = RunParameterAnalysis();
    }

    private async Task RunParameterAnalysis()
    {
        IsAnalyzingParameter = true;
        MaintenanceReport = null;
        StateHasChanged();

        try
        {
            MaintenanceReport = await ApiClient.GetPredictiveMaintenanceReportAsync(
                SelectedMachine, SelectedParameter, ReportFromDate, ReportToDate, token: Session.Token);
        }
        finally
        {
            IsAnalyzingParameter = false;
        }
    }
}
